<!DOCTYPE html>
<html>

<head>

<title>Pokemon TCG Indonesia Market</title>

<style>

body{
font-family:Arial;
background:#f2f2f2;
text-align:center;
}

h1{
color:#333;
}

#search{
padding:10px;
width:300px;
margin-bottom:20px;
}

.card{
background:white;
padding:20px;
margin:20px;
border-radius:10px;
display:inline-block;
width:250px;
box-shadow:0 0 10px rgba(0,0,0,0.1);
}

img{
width:150px;
}

button{
background:red;
color:white;
border:none;
padding:10px;
border-radius:5px;
cursor:pointer;
}

#listings{
margin-top:40px;
}

</style>

</head>

<body>

<h1>Pokemon TCG Indonesia Market</h1>

<input id="search" placeholder="Search card..." onkeyup="searchCard()">

<div id="cards"></div>

<div id="listings"></div>

<script>

const cards = [

{
name:"Caterpie",
set:"Ikatan Takdir",
price:"Rp800",
img:"https://asia.pokemon-card.com/id/card-img/id00015676.png"
},

{
name:"Mega Gengar ex",
set:"Korbaran Biru",
price:"Rp40.000",
img:"https://asia.pokemon-card.com/id/card-img/id00016872.png"
}

];


const listings = {

"Caterpie":[

{
seller:"Scorphex",
price:"Rp800",
platform:"Tokopedia",
link:"https://www.tokopedia.com/scorphex/sv9s-caterpie-001-139-c-ikatan-takdir-kartu-pokemon-tcg-trading-card-game-indonesia-1731188217176819162?utm_campaign=PDP-z5fb7zq4pa1s-16595086012-0&utm_source=salinlink&utm_medium=share"
},



],

"Mega Gengar Ex":[

{
seller:"Topdeck",
price:"Rp40.000",
platform:"Tokopedia",
link:"https://www.tokopedia.com/topdeck/mega-gengar-ex-rr-058-103-kobaran-biru-ma2-pokemon-tcg-indonesia-1733468003099510247?extParam=ivf%3Dfalse%26keyword%3Dmega+gengar%26search_id%3D202603141150588D3BBA7425E7C910FE7A%26src%3Dsearch&t_id=1773489078745&t_st=1&t_pp=search_result&t_efo=search_pure_goods_card&t_ef=goods_search&t_sm=&t_spt=search_result"
}

]

};


function showCards(list){

let html="";

list.forEach(card=>{

html+=`

<div class="card">

<img src="${card.img}">

<h3>${card.name}</h3>

<p>${card.set}</p>

<p>${card.price}</p>

<button onclick="showListings('${card.name}')">
View Listings
</button>

</div>

`;

});

document.getElementById("cards").innerHTML=html;

}


function showListings(cardName){

let cardListings = listings[cardName];

let html = "<h2>Listings for "+cardName+"</h2>";

cardListings.forEach(listing=>{

html+=`

<div class="card">

<h3>${listing.seller}</h3>

<p>Price: ${listing.price}</p>

<p>Platform: ${listing.platform}</p>

<a href="${listing.link}" target="_blank">

<button>Buy</button>

</a>

</div>

`;

});

document.getElementById("listings").innerHTML = html;

}


function searchCard(){

let input = document.getElementById("search").value.toLowerCase();

let filtered = cards.filter(card =>
card.name.toLowerCase().includes(input)
);

showCards(filtered);

}


showCards(cards);

</script>

</body>

</html>
