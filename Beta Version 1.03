padding:10px;
margin:10px;
background:red;
color:white;
border:none;
border-radius:5px;
cursor:pointer;
}

.card{
background:white;
padding:20px;
margin:20px;
border-radius:10px;
display:inline-block;
width:250px;
}

img{
width:150px;
}

</style>

</head>

<body>

<h1>Pokemon TCG Indonesia</h1>

<h2>Select a Set</h2>

<div id="sets"></div>

<h2>Cards</h2>

<div id="cards"></div>

<h2>Listings</h2>

<div id="listings"></div>

