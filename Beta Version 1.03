}
]

};



function showSets(){

let html="";

sets.forEach(set=>{

html+=`

<button onclick="showSetCards('${set}')">
${set}
</button>

`;

});

document.getElementById("sets").innerHTML=html;

}


function showSetCards(setName){

let filtered = cards.filter(card => card.set === setName);

let html="";

filtered.forEach(card=>{

html+=`

<div class="card">

<img src="${card.img}">

<h3>${card.name}</h3>

<p>${card.price}</p>

<button onclick="showListings('${card.name}')">
View Listings
</button>

</div>

`;

});

document.getElementById("cards").innerHTML=html;

}


function showListings(cardName){

let cardListings = listings[cardName];

let html="<h3>"+cardName+" Listings</h3>";

cardListings.forEach(listing=>{

html+=`

<div class="card">

<p>${listing.seller}</p>

<p>${listing.price}</p>

<p>${listing.platform}</p>

<a href="${listing.link}" target="_blank">
<button>Buy</button>
</a>

</div>

`;

});

document.getElementById("listings").innerHTML=html;

}

showSets();

</script>

</body>

</html>
